# ============================================================
# SamaImmo — configuration (copier en .env et ajuster)
#   cp .env.example .env
# ============================================================

# URL publique de l'application (utilisée dans les QR codes des quittances
# et les liens de partage). En production : https://gestion.mon-agence.sn
BASE_URL=http://localhost:8000

# --- Connexion par code SMS (OTP) ---
# true  = mode démo : le code s'affiche à l'écran (aucun SMS envoyé, aucun coût).
#         IDEAL pour les tests et la mise en route, à passer à false en production.
OTP_DEV_MODE=true

# --- Envoi réel des SMS (n'importe quel opérateur : Orange, Free, Expresso…) ---
# Passerelle générique : le service doit accepter POST {phone, message, sender}
# avec en-tête Authorization: Bearer <clé>. Exemples : agrégateur local, Twilio proxy…
SMS_PROVIDER=console
#SMS_PROVIDER=http
#SMS_HTTP_URL=https://api.mon-agregateur-sn.com/v1/send
#SMS_HTTP_KEY=votre-cle-api
#SMS_SENDER_NAME=SamaImmo

# --- Divers ---
#OTP_TTL_MIN=5            # durée de vie du code (minutes)
#OTP_RESEND_SEC=60        # délai anti-spam entre deux demandes de code
#JWT_TTL_DAYS=30          # durée de la session
#BACKUP_HOUR=3            # heure locale de la sauvegarde quotidienne
#BACKUP_KEEP_DAYS=14      # rétention des sauvegardes
#DATA_DIR=./data          # emplacement base + fichiers (défaut: ./data)
